# =====================================================
# APP
# =====================================================
# APP_NAME=landmark-agent
# ENV=development
# DEBUG=True

# =====================================================
# DEVICE & VISION MODEL
# =====================================================
DEVICE=cpu
# BASE_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
# LORA_PATH=imbee510/qwen2-5-vl-landmark-lora
# HF_HOME=./hf_cache
# HF_TOKEN=your_huggingface_token

# =====================================================
# REMOTE INFERENCE & DATABASE (REQUIRED)
# =====================================================
PINGGY_URL=your_pinggy_url_here
NGROK_TOKEN=your_ngrok_token
SUPABASE_URL=your_supabase_postgres_url

# =====================================================
# LLM PROVIDERS
# =====================================================
GROQ_API_KEY=your_groq_key
# OPENAI_API_KEY=your_openai_api_key

# =====================================================
# WEATHER API
# =====================================================
# WEATHER_API_KEY=your_weather_api_key
# OPENWEATHER_API_KEY=your_openweather_key
# OPENWEATHER_CURRENT_URL=https://api.openweathermap.org/data/2.5/weather
# OPENWEATHER_FORECAST_URL=https://api.openweathermap.org/data/2.5/forecast
# OPENWEATHER_GEOCODING_URL=http://api.openweathermap.org/geo/1.0/direct

# =====================================================
# SEARCH (SERPAPI)
# =====================================================
# SERPAPI_API_KEY=your_serpapi_key

# =====================================================
# LANGSMITH (TRACING)
# =====================================================
# LANGCHAIN_TRACING_V2=False
# LANGCHAIN_API_KEY=your_langchain_api_key
# LANGCHAIN_PROJECT=landmark-agent
